{
  "name": "bottt-mcp",
  "version": "1.0.0",
  "description": "Local MCP server that drives BOTTT (speak, smile, status) over the Mac Unix socket.",
  "type": "module",
  "private": true,
  "bin": {
    "bottt-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
